# Copie para .env (na mesma pasta do docker-compose.yml) e preencha.
# Nunca commite o .env preenchido em lugar nenhum.

# Domínio principal onde os sites de clientes são publicados
# (deve ser o mesmo valor do campo "dominio" em prospector-config.json).
DOMINIO=seudominio.com.br

# Subdomínio para o painel do Portainer (precisa de um registro DNS tipo A
# próprio, além do DOMINIO acima).
PORTAINER_DOMINIO=portainer.seudominio.com.br

# E-mail usado pelo Let's Encrypt (avisos de expiração de certificado).
ACME_EMAIL=seu@email.com

# Pasta no host onde o /publicar grava os arquivos (SSH/SCP) — deve ser
# EXATAMENTE o mesmo caminho configurado em prospector-config.json no
# campo "vps.caminhoRemoto".
CAMINHO_SITES=/opt/prospector/sites
